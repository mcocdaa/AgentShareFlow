{
  "name": "agentshareflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "registry": "pnpm --filter @agentshare/registry dev",
    "web": "pnpm --filter @agentshare/web dev",
    "cli": "pnpm --filter @agentshare/cli dev --",
    "dsh:sync": "bash scripts/sync-dsh-plugin.sh",
    "mock:share": "node scripts/mock-share-agent.mjs",
    "mock:a2a": "node scripts/mock-a2a-agent.mjs"
  }
}
