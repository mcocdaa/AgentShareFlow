{
  "name": "agentshareflow",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "server": "pnpm --filter @agentshare/server dev",
    "web": "pnpm --filter @agentshare/web dev",
    "node": "pnpm --filter @agentshare/node dev --",
    "demo": "node scripts/demo.mjs"
  }
}
