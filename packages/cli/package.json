{
  "name": "@agentshare/cli",
  "version": "0.1.0",
  "description": "Command-line client for AgentShareFlow: publish and install Agent Packs, review handoffs, and manage share outcomes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcocdaa/AgentShareFlow.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "agentshare": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "agent",
    "agentshare",
    "cli",
    "agent-pack",
    "handoff"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentshare/core": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
