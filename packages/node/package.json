{
  "name": "@agentshare/node",
  "version": "2.1.0",
  "description": "Local agent node daemon, CLI, Direct P2P & werift WebRTC transport, Local Policy Guard, and MCP server for AgentShareFlow v2.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentshare": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentshare/core": "workspace:*",
    "commander": "^15.0.0",
    "werift": "^0.28.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@agentshare/server": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
