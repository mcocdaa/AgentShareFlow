# AgentShareFlow relay 配置模板：复制为 .env 后编辑。
#   cp .env.example .env && vim .env
# .env 含密钥，已在 .gitignore 中；不要提交或公开分享。

# 必填。发布者凭据，格式 token:owner[,token2:owner2]。token 即发布/撤销身份。
# 生成：openssl rand -hex 24
AGENTSHARE_TOKENS=replace-with-generated-token:owner

# 分享链接使用的对外地址。本地保留 loopback；公网部署替换为不带路径的 HTTPS origin。
AGENTSHARE_PUBLIC_URL=http://127.0.0.1:8787

# 可选。宿主机监听绑定与端口。默认仅 loopback，适用于宿主机反向代理；
# 容器化反向代理需要跨容器访问时改为 0.0.0.0。
AGENTSHARE_BIND=127.0.0.1
AGENTSHARE_PORT=8787

# 可选。容器内数据目录（SQLite + packs），compose 已挂 relay-data 卷，一般不需要改。
AGENTSHARE_DATA=/data

# 可选。构建镜像使用的 npm registry（国内加速）。
# 修改后重新构建生效：docker compose up -d --build
# NPM_REGISTRY=https://registry.npmmirror.com
