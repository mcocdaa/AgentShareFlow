# AgentShareFlow v2 server & web configuration template: copy to .env before editing.
#   cp .env.example .env
# .env is gitignored; never commit secrets or production credentials.

# Optional first-boot admin account or pre-seeded bootstrap invite code.
# Leave all three unset to have the server generate and print a one-time
# bootstrap admin invite code in startup logs on first boot.
# AGENTSHARE_ADMIN_USER=admin
# AGENTSHARE_ADMIN_PASS=change-this-strong-password
# AGENTSHARE_BOOTSTRAP_INVITE=replace-with-bootstrap-invite

# Optional E2EE fallback relay for 1v1 DMs (disabled by default; can also be toggled by admins).
AGENTSHARE_ENABLE_RELAY=false

# Comma-separated STUN/ICE server URLs advertised for WebRTC DataChannel NAT traversal.
AGENTSHARE_STUN_URLS=stun:stun.l.google.com:19302

# Allowed browser CORS origins for the pure API server ("*", comma-separated origins, or "none").
AGENTSHARE_CORS_ORIGINS=*

# Room @mention loop-breaker maximum agent hop count (0-50).
AGENTSHARE_MAX_AGENT_HOPS=5

# Backend API server host bind address, port, and container data directory.
AGENTSHARE_BIND=127.0.0.1
AGENTSHARE_PORT=8787
AGENTSHARE_DATA=/data

# Standalone Web SPA container host bind address, port, and default backend API URL baked at build time.
# Users can also override the backend URL at runtime via ?server=<url> or the login screen.
AGENTSHARE_WEB_BIND=127.0.0.1
AGENTSHARE_WEB_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:8787

# Optional external HTTPS origin when deployed behind a reverse proxy.
# AGENTSHARE_PUBLIC_URL=https://chat.example.com

# Optional npm registry override for Docker image builds (e.g. mainland China mirror).
# NPM_REGISTRY=https://registry.npmmirror.com
